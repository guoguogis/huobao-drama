PORT=5679

# Optional. SQLite 数据库文件位置（默认仓库根 data/huobao.sqlite3）
# SQLITE_PATH=/path/to/huobao.sqlite3

# Optional. 数据根目录（默认仓库根 data/；桌面版由 Electron 注入 HUOBAO_DATA_DIR）
# HUOBAO_DATA_DIR=/path/to/data
# STORAGE_PATH=/path/to/data/static

# Optional. MySQL → SQLite 启动自动迁移（老用户升级）：显式配置 DATABASE_URL 或
# MYSQL_HOST 且 SQLite 为空库时，启动自动一次性导入全部表（原子事务 + 行数校验 +
# 成功后写 .mysql-imported 标记）。关闭：MYSQL_AUTO_IMPORT=false
# DATABASE_URL=mysql://huobao:huobao@127.0.0.1:3306/huobao_drama

# Optional. Public base URL of this backend. When set, locally uploaded reference
# videos/audios/files are exposed to the upstream video API as signed URLs
# (PUBLIC_BASE_URL + /static path + ?e=<expiry>&s=<hmac>). The login guard verifies
# that signature, so assets never need to be world-readable.
# PUBLIC_BASE_URL=https://your-domain.com

# Optional. How local reference videos/audios reach the upstream API.
#   auto (default) — inline as Base64 when PUBLIC_BASE_URL is unset (local dev,
#                    where the model provider cannot reach your machine),
#                    otherwise signed public URLs.
#   inline         — always inline Base64 (provider never fetches from us).
#   public         — always signed public URLs (requires PUBLIC_BASE_URL).
# MEDIA_REF_MODE=auto

# Optional. Max file size (MB) eligible for Base64 inlining; larger files fall back
# to signed URLs. Default 15, matching Ark's 15MB per-reference-audio limit.
# MEDIA_INLINE_MAX_MB=15

# Optional. Format token used in audio data URIs when inlining.
#   mime (default) — `data:audio/mpeg;base64,` for mp3 (registered MIME subtype,
#                    consistent with the image path which always emits data:image/jpeg)
#   extension      — `data:audio/mp3;base64,` for mp3 (matches the docs' "<格式> 小写"
#                    wording literally). Switch here if the upstream rejects the format.
# MEDIA_AUDIO_DATA_URI_FORMAT=mime

# Optional. Lifetime (hours) of signed media URLs. Default 6.
# MEDIA_URL_TTL_HOURS=6

# Optional. 关闭文本模型思考(thinking)模式,默认 true。
# 对 new-api 类中转站在请求体注入关思考参数,规避中转站强制回传
# reasoning_content 导致的 400;官方 OpenAI/Gemini 端点自动跳过。
# AI_DISABLE_THINKING=false
# 可选:自定义注入的 OpenAI 风格参数(JSON),适配不同中转站
# AI_THINKING_OFF_PATCH={"thinking":{"type":"disabled"},"enable_thinking":false}
